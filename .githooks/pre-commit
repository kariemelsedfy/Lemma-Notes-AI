#!/usr/bin/env bash
set -euo pipefail

repository_root="$(git rev-parse --show-toplevel)"
cd "$repository_root"

staged_swift_files=()
while IFS= read -r -d '' staged_file; do
    staged_swift_files+=("$staged_file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')

if [[ ${#staged_swift_files[@]} -eq 0 ]]; then
    exit 0
fi

swiftlint lint --strict --config .swiftlint.yml "${staged_swift_files[@]}"
xcrun swift-format lint --strict --parallel "${staged_swift_files[@]}"
